# Required on a public server: the code you type to create the first (admin) account.
SETUP_CODE=change-me

# Optional: lets teammates create their own account with this code.
# Leave empty so only admins can add people (Settings > Team).
SIGNUP_CODE=

# Google Workspace connector (Sheets, Drive, Calendar). Leave empty to hide Google features.
# Google Cloud Console > APIs & Services:
#   1. OAuth client ID, type "Web application", authorised JavaScript origin https://calendar.oriondesk.space
#   2. Enable: Google Drive API, Google Sheets API, Google Calendar API, Google Picker API
#   3. API key (restrict it to the Picker API and your domain)
#   4. GOOGLE_APP_ID is the numeric project number
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
